#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> go vet"
go vet ./...

echo "==> go fix"
# `go fix` can rewrite files in place without printing anything, so compare
# the worktree against the staged set: any change to a staged file is a hard
# fail with a re-stage hint, instead of a silent follow-up commit.
go fix ./... > /dev/null
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  modified=$(git diff --name-only -- $staged)
  if [ -n "$modified" ]; then
    echo "go fix modified staged files:"
    echo "$modified"
    echo ""
    echo "Re-stage and commit again:"
    echo "  git add $(echo $modified | tr '\n' ' ') && git commit ..."
    exit 1
  fi
fi

echo "==> gofmt"
# Prune .claude so a parallel agent's half-written worktree cannot fail the
# main checkout's commit; the Go toolchain skips dot-directories too.
unformatted=$(find . -path ./.claude -prune -o -name '*.go' -print0 | xargs -0 gofmt -l)
if [ -n "$unformatted" ]; then
  echo "gofmt needs to format these files:"
  echo "$unformatted"
  echo ""
  echo "Run: gofmt -w ."
  exit 1
fi

echo "==> go mod tidy"
go mod tidy
if ! git diff --quiet -- go.mod go.sum; then
  echo "go.mod or go.sum changed after go mod tidy"
  echo "Run: go mod tidy && git add go.mod go.sum"
  exit 1
fi

echo "==> go test"
go test ./...

echo "==> agents check"
agents check

echo ""
echo "All checks passed."
